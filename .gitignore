# ─────────────────────────────────────────────────────────────────────────────
# Rules that protect ANYONE working on this repo. Tracked deliberately: a fresh
# clone needs these or a collaborator's first commit can carry hundreds of MB of
# raw data (GitHub hard-rejects >100 MB per file).
#
# Personal, machine-specific ignores live in .git/info/exclude instead — same
# syntax, never tracked, never pushed.
# ─────────────────────────────────────────────────────────────────────────────

# The test suite itself IS tracked (tests/run_tests.R, tests/testthat/, tests/validation/):
# it is how a reader checks the estimators. Only sample DATA is ignored — raw MINFLUX
# exports are hundreds of MB and are not needed to run the app; users bring their own.
tests/data/
tests/**/*.npy
tests/**/*.csv.gz

Test data/
test data/
*.npy
*.msr
*.zarr/

# Large/raw data formats that occasionally land in the repo root
*.csv.gz
*.fst
*.qs

# Work in progress: parked features, not part of the shipped app.
pending/

# Claude Code workspace config (machine-specific)
.claude/

# R session cruft
.Rhistory
.Rproj.user/
.RData
.RDataTmp
.Ruserdata

# Personal strategy/planning notes — never published.
private/

# Validation run logs: console output of the scripts in tests/validation/. The CSV
# next to each one is the tracked result; re-running the script recreates the log.
tests/validation/results/*.log
tests/validation/results/*_before_fix.csv

# Validation runs on real acquisitions: the scripts are tracked, their results stay local.
tests/validation/results/fiducial_labelled.csv
tests/validation/results/hotspot_realdata_recheck.csv

# testthat writes failure snapshots here automatically; never commit them.
tests/testthat/_problems/
