  - family-names: "Doughty"
    given-names: "Luke"
    orcid: "https://orcid.org/0009-0002-9342-5456"
  - family-names: "Brewer"
    given-names: "Jonathan"
    affiliation: "Department of Biochemistry and Molecular Biology, University of Southern Denmark"
repository-code: "https://github.com/ViktorMebus/MINFLUXR"
license: GPL-3.0-or-later
keywords:
  - MINFLUX
  - super-resolution microscopy
  - single-molecule localization microscopy
  - single-particle tracking
  - Shiny
  - R
